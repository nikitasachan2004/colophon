FROM python:3.11-slim

LABEL org.opencontainers.image.title="Colophon API" \
      org.opencontainers.image.description="Colophon RAG Knowledge Assistant — FastAPI backend"

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    # Use CPU for reranker (no MPS/CUDA on free-tier hosting)
    FORCE_CPU_RERANKER=1 \
    # Ensure offline mode so HF Hub is never contacted at container startup
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    HF_HUB_DISABLE_SYMLINKS_WARNING=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install runtime deps only (no ragas/datasets/langchain eval stack)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Pre-download ONNX embedder, ONNX reranker, and tiktoken models during image build so startup is 100% offline with zero download memory spike
RUN HF_HUB_OFFLINE=0 TRANSFORMERS_OFFLINE=0 python -c "from huggingface_hub import hf_hub_download; from tokenizers import Tokenizer; import tiktoken; \
    tiktoken.get_encoding('cl100k_base'); \
    import chromadb.utils.embedding_functions as ef; ef.ONNXMiniLM_L6_V2()(['test']); \
    hf_hub_download(repo_id='xenova/all-MiniLM-L6-v2', filename='onnx/model_quantized.onnx'); \
    hf_hub_download(repo_id='xenova/ms-marco-MiniLM-L-6-v2', filename='onnx/model_quantized.onnx'); \
    hf_hub_download(repo_id='xenova/ms-marco-MiniLM-L-6-v2', filename='tokenizer.json'); \
    Tokenizer.from_pretrained('cross-encoder/ms-marco-MiniLM-L-6-v2')"

COPY . .

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=90s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["uvicorn", "src.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
