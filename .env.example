# LLM Backend — "ollama" for local dev, "groq" for production
LLM_BACKEND=groq

# Ollama (local dev — only needed if LLM_BACKEND=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Groq (production) — free key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Chunking
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_PCT=0.12

# Retrieval
RETRIEVAL_TOP_K=20
RERANK_CANDIDATE_POOL=10
RERANK_FINAL_K=5
CONFIDENCE_THRESHOLD=0.35

# Storage
CHROMA_PERSIST_DIR=./data/chroma_db

# API
API_HOST=0.0.0.0
API_PORT=8000

# Admin endpoints (keep false in production)
ENABLE_ADMIN=false

# RAGAS Evaluation Judge (evaluation runs only — not used at runtime)
# Ollama is preferred: zero quota, fully local.
# Fallback: RAGAS_JUDGE_BACKEND=groq  RAGAS_JUDGE_MODEL=allam-2-7b
RAGAS_JUDGE_BACKEND=ollama
RAGAS_JUDGE_MODEL=llama3.1:8b
RAGAS_JUDGE_OLLAMA_URL=http://localhost:11434
